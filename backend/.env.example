# Copy to .env (never commit .env). Every value below is a PLACEHOLDER.

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.prod        # config.settings.dev for local work
DJANGO_SECRET_KEY=change-me-generate-with-python-secrets-token-urlsafe-64-xxxxxxxxxxxxxxxxxxxxxxxx
DJANGO_ALLOWED_HOSTS=tasks.example.com
CSRF_TRUSTED_ORIGINS=https://tasks.example.com
WS_ALLOWED_ORIGINS=https://tasks.example.com       # origins allowed to open WebSockets (browsers); empty = reject browser origins
BEHIND_TLS_PROXY=true                              # trust X-Forwarded-Proto only if your proxy sets it
SECURE_SSL_REDIRECT=true
LOG_LEVEL=INFO
ADMIN_URL=admin/                                   # change to an unguessable prefix in production, e.g. manage-7f3k/

# --- PostgreSQL (authoritative store) ---
DB_ENGINE=postgres
DB_NAME=ecotasks
DB_USER=ecotasks_app
DB_PASSWORD=change-me-db-password
DB_HOST=db
DB_PORT=5432

# --- Redis (channel layer, cache, throttling) ---
REDIS_URL=redis://:change-me-redis-password@redis:6379/0

# --- First owner (used ONLY by `manage.py bootstrap_owner`; remove the password afterwards) ---
INITIAL_OWNER_USERNAME=owner
INITIAL_OWNER_EMAIL=owner@example.com
INITIAL_OWNER_PASSWORD=change-me

# --- Business policy ---
CURRENCY=UZS
TASK_COMPLETION_REQUIRES_APPROVAL=true
API_ACCESS_TOKEN_MINUTES=60                        # short-lived access token
API_REFRESH_TOKEN_DAYS=14                          # sign-in lasts this long without using the password again
UPLOAD_MAX_BYTES=10485760
PRIVATE_MEDIA_ROOT=/data/private_media

# --- Push notifications (Firebase Cloud Messaging) ---
FIREBASE_CREDENTIALS_FILE=                         # path to the Firebase service-account JSON (never commit it); empty = push off

# --- Backups (see docs/DATABASE_BACKUP_AND_RECOVERY.md) ---
BACKUP_DIR=/backups
BACKUP_RETENTION_DAYS=30
BACKUP_GPG_RECIPIENT=backup@example.com            # public-key recipient; the private key is NOT kept on the server
BACKUP_REMOTE_TARGET=s3://example-bucket/ecotasks  # off-server copy, mandatory in production
BACKUP_ALERT_WEBHOOK=                              # optional URL notified on failure
