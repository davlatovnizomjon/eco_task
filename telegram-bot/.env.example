# Copy to .env (never commit .env). Every value below is a PLACEHOLDER.

# Token from @BotFather
BOT_TOKEN=123456:replace-me

# Base URL of the Eco Tasks REST API, with the /api/v1 prefix and no trailing slash
API_BASE_URL=http://localhost:8000/api/v1

# Where linked accounts (chat id -> API token) are stored. Contains secrets: keep it out of git and backups you share.
DATA_FILE=./data/store.json

# How often (seconds) the bot looks for new notifications of every linked client
POLL_SECONDS=15
